FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0.0 0.0 0.0);

boundaryField
{

    inlet
    {
        type                uniformFixedValue;
        uniformValue        sine;
        uniformValueCoeffs
        {
            frequency       2;              // [Hz] pulsation frequency
            amplitude       0.0155;         // peak deviation from the mean speed
            scale           (0 1 0);        // align pulsation with the inlet normal
            level           (0 0.031 0);    // mean velocity vector
        }
        value               uniform (0 0.031 0);
    }

    outlet
    {
        type        pressureInletOutletVelocity;
        value       $internalField;
    }

    wall
    {
        // movingWallVelocity reduces to fixedValue if the mesh is not moving
        type        movingWallVelocity;
        value       uniform (0 0 0);
    }

    defaultFaces
    {
        type        slip;
        value       $internalField;
    }

}

